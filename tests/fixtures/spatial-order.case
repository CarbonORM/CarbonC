-- query
{"FROM":"property_units","SELECT":["property_units.unit_id"],"PAGINATION":{"LIMIT":25,"ORDER":[[["ST_Distance_Sphere","property_units.location",["ST_SRID",["ST_Point",["PARAM",10],["PARAM",20]],4326]],"ASC"]]}}
-- sql
