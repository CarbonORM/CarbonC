-- query
{"FROM":"property_units","SELECT":["property_units.unit_id"],"WHERE":{"EXISTS":[["property_units.parcel_id",{"SUBSELECT":{"SELECT":["parcel_building_details.parcel_id"],"FROM":"parcel_building_details","WHERE":{"parcel_building_details.year_built":["BETWEEN",[1988,2008]],"parcel_building_details.gla":["BETWEEN",[1876.5,3127.5]]}}}],["property_units.parcel_id",["SUBSELECT",{"SELECT":["parcel_sales.parcel_id"],"FROM":"parcel_sales","WHERE":{"parcel_sales.sale_date":["BETWEEN",[["LIT","2023-01-01"],["LIT","2024-06-30"]]],"parcel_sales.sale_price":["<>",0]}}]]],"property_units.unit_id":[">",1]},"PAGINATION":{"LIMIT":100}}
-- sql
SELECT property_units.unit_id FROM `property_units` WHERE EXISTS (SELECT parcel_building_details.parcel_id FROM `parcel_building_details` WHERE (parcel_building_details.year_built) BETWEEN ? AND ? AND (parcel_building_details.gla) BETWEEN ? AND ? AND (parcel_building_details.parcel_id) = property_units.parcel_id) AND EXISTS (SELECT parcel_sales.parcel_id FROM `parcel_sales` WHERE (parcel_sales.sale_date) BETWEEN ? AND ? AND (parcel_sales.sale_price) <> ? AND (parcel_sales.parcel_id) = property_units.parcel_id) AND (property_units.unit_id) > ? LIMIT 100
